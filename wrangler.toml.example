# Cloudflare Pages config. /launch copies this to wrangler.toml and fills in the database id.
name = "resume-forge"
pages_build_output_dir = "./dist"
compatibility_date = "2025-09-01"

[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "resume-forge-db"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
AI_DAILY_CREDITS = "15"
AI_GUEST_DAILY_CREDITS = "6"
AI_GLOBAL_DAILY_CREDITS = "100"
# GOOGLE_CLIENT_ID = "....apps.googleusercontent.com"   (added in step 8 of /launch)
