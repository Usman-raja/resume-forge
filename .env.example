# Copy to .env for local testing (never commit .env). In Cloudflare Pages, add
# the same names under Settings → Environment variables (Production).

# --- Public (used at build time and in the browser) ---
SITE_URL=https://yourdomain.com
SITE_NAME=Resume Forge
CONTACT_EMAIL=hello@yourdomain.com
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
# Optional
GA_ID=
GOOGLE_SITE_VERIFICATION=
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_GALLERY=
ADSENSE_SLOT_TEMPLATE=
ADSENSE_SLOT_EXAMPLE=
ADSENSE_SLOT_BUILDER=
ADSENSE_SLOT_COVER=

# --- Secret (server only — add as "Encrypted" in Cloudflare) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# or: AI_PROVIDER=gemini and GEMINI_API_KEY=...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# --- AI limits (optional) ---
# Credits per user per day. Big actions (import/improve/tailor) cost 3, review/cover letter 2, one-line rewrites 1.
AI_DAILY_CREDITS=30
# Hard cap on credits for the whole site per day (protects your bill).
AI_GLOBAL_DAILY_CREDITS=1500
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MODEL_HEAVY=            (optional stronger model for import/improve/tailor)
# AI_REQUIRE_LOGIN=true      (keep true in production)
