# Copy to .env for local testing (never commit .env).
# On Cloudflare Pages add the same names under Settings → Variables and Secrets.

# --- Public (baked into pages at build time) ---
SITE_URL=https://yourdomain.com
SITE_NAME=Resume Forge
CONTACT_EMAIL=hello@yourdomain.com
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# --- Secrets (server only — mark as "Secret"/Encrypt on Cloudflare) ---
GOOGLE_CLIENT_SECRET=GOCSPX-...
SESSION_SECRET=paste-a-long-random-string-here-40-plus-characters

# --- AI limits (credits per UTC day). Full rewrite = 3, AI review / cover letter = 2, one-line rewrite = 1 ---
AI_DAILY_CREDITS=15          # signed-in users
AI_GUEST_DAILY_CREDITS=6     # visitors without an account (0 = must sign in)
AI_GLOBAL_DAILY_CREDITS=100  # whole site. ~100 fits Cloudflare's free 10,000 neurons/day
# AI_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct   (default; any Workers AI text model)

# --- Bindings (NOT variables — add under Settings → Bindings) ---
#   AI → Workers AI
#   DB → D1 database (run db/schema.sql in its console once)

# --- Optional paid upgrade (only if you ever want it) ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ads / analytics (optional) ---
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_GALLERY=
ADSENSE_SLOT_TEMPLATE=
ADSENSE_SLOT_EXAMPLE=
ADSENSE_SLOT_BUILDER=
ADSENSE_SLOT_COVER=
GA_ID=
GOOGLE_SITE_VERIFICATION=

# --- Local development only ---
# MOCK_AI=1                  fake AI answers
# DEV_LOGIN=1                /api/dev-login signs you in as a test user
# CF_ACCOUNT_ID= / CF_API_TOKEN=   use real Workers AI from your computer
